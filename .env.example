# npuhalo-speech — copy to .env and adjust as needed
# The launchers and server.py also read these from the environment.

# Hugging Face token for the gated pyannote model (falls back to VAD+KMeans without it)
HF_TOKEN=

# API key for the OpenAI-compatible server; "EMPTY" means no auth (vLLM convention)
# If unset, server.py auto-generates one and prints it.
API_KEY=
# Alternative env var read by server.py:
# OPENAI_API_KEY=

# Lemonade NPU daemon URL
LEMONADE_URL=http://127.0.0.1:13305

# Default diarization device for server.sh / server.py
# cpu | rocm | cuda | auto
# Default device is set via --device flag; this env var is not read by the launchers.
